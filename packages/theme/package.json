{
  "name": "@carrental/theme",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "gen:css": "node scripts/gen-tokens-css.mjs",
    "check:css": "node scripts/gen-tokens-css.mjs --check"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@carrental/config": "workspace:*",
    "eslint": "9.9.0",
    "globals": "15.9.0",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
