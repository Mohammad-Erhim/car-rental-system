{
  "name": "@carrental/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --watch-preserve-output -r @swc-node/register src/main.ts",
    "dev:worker": "node --watch -r @swc-node/register src/worker.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node -r @swc-node/register src/main.ts",
    "start:dist": "node dist/main.js",
    "start:worker": "node -r @swc-node/register src/worker.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:migrate": "vitest run --config vitest.api.config.ts test/migrate.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -r @swc-node/register src/database/migrate.ts",
    "db:seed": "node -r @swc-node/register src/database/seed/seed.ts",
    "db:reset": "node -r @swc-node/register src/database/reset.ts",
    "openapi:generate": "node -r @swc-node/register src/openapi.ts"
  },
  "dependencies": {
    "@carrental/contracts": "workspace:*",
    "@carrental/i18n": "workspace:*",
    "@nestjs/common": "10.4.1",
    "@nestjs/core": "10.4.1",
    "@nestjs/platform-express": "10.4.1",
    "@nestjs/swagger": "7.4.0",
    "@node-rs/argon2": "1.8.3",
    "bullmq": "5.12.12",
    "compression": "1.7.4",
    "cookie-parser": "1.4.6",
    "drizzle-orm": "0.33.0",
    "helmet": "7.1.0",
    "ioredis": "5.4.1",
    "nestjs-pino": "4.1.0",
    "nestjs-zod": "3.0.0",
    "pino": "9.3.2",
    "pino-http": "10.2.0",
    "postgres": "3.4.4",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "uuid": "10.0.0",
    "zod": "3.23.8",
    "jose": "5.6.3",
    "nanoid": "5.0.7"
  },
  "devDependencies": {
    "@carrental/config": "workspace:*",
    "@nestjs/testing": "10.4.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.13.21",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/node": "20.14.15",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "drizzle-kit": "0.24.2",
    "eslint": "9.9.0",
    "globals": "15.9.0",
    "pino-pretty": "11.2.2",
    "supertest": "7.0.0",
    "tsc-alias": "1.8.10",
    "typescript": "5.5.4",
    "unplugin-swc": "1.5.1",
    "vitest": "2.0.5"
  }
}
