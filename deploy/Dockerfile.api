# syntax=docker/dockerfile:1.7
# Car Rental System — API + worker image.
#   dev target  : hot-reload, source bind-mounted by compose.yaml
#   runtime tgt : compiled dist + a pruned prod node_modules, non-root, healthchecked
#
#   docker build -f deploy/Dockerfile.api --target runtime -t carrental-api .
#   docker build -f deploy/Dockerfile.api --target dev     -t carrental-api:dev .

########################  base  ########################
FROM node:22-bookworm-slim AS base
# max-old-space-size pinned rather than left to Node's default: Node sizes its default heap off
# detected host memory, which on a small/burstable instance (observed: a 1 vCPU/1GB box) undersizes
# it enough that `tsc` on this workspace V8-OOMs (SIGABRT, exit 134) mid-build instead of just
# running slower.
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1 NODE_OPTIONS=--max-old-space-size=2048
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate \
 && pnpm config set store-dir /pnpm/store --global
WORKDIR /app

########################  deps  ########################
# Install the whole workspace (dev deps included) with a cached pnpm store.
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY apps/api/package.json           apps/api/package.json
COPY apps/web/package.json           apps/web/package.json
COPY e2e/package.json                e2e/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/client/package.json    packages/client/package.json
COPY packages/i18n/package.json      packages/i18n/package.json
COPY packages/ui/package.json        packages/ui/package.json
COPY packages/theme/package.json     packages/theme/package.json
COPY packages/config/package.json    packages/config/package.json
COPY scripts/patch-expo-localization.mjs scripts/patch-expo-localization.mjs
COPY scripts/patch-stripe-cardfield.mjs   scripts/patch-stripe-cardfield.mjs
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

########################  dev  ########################
# Just the workspace deps + toolchain. All source (apps/ and packages/) is bind-mounted by
# compose; the `deps` one-shot service builds the shared CJS packages into a shared volume
# before the API starts. Edits on the host hot-reload via `node --watch`.
FROM deps AS dev
ENV NODE_ENV=development NODE_OPTIONS=--enable-source-maps
EXPOSE 3001
CMD ["pnpm", "--filter", "@carrental/api", "dev"]

########################  build  ########################
FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/ packages/
COPY apps/api/ apps/api/
# `pnpm deploy` hard-copies the app + its (workspace and external) prod deps into a
# self-contained tree — no symlinks back into /app. `--legacy` is pnpm 10 only; pnpm 9's
# deploy already uses this behaviour.
RUN pnpm --filter @carrental/theme --filter @carrental/contracts --filter @carrental/i18n build \
 && pnpm --filter @carrental/api build \
 && pnpm --filter @carrental/api --prod deploy /prod

########################  runtime  ########################
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production NODE_OPTIONS=--enable-source-maps
# tini as PID 1 (ENTRYPOINT below): reap zombies and forward signals for a clean `docker stop`
# — node:*-slim does not bundle it. The dev target has no entrypoint, so compose.yaml sets
# `init: true` there instead; compose.prod.yaml relies on this and omits it.
RUN apt-get update && apt-get install -y --no-install-recommends tini \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /prod/node_modules ./node_modules
COPY --from=build --chown=node:node /app/apps/api/dist ./dist
COPY --from=build --chown=node:node /app/apps/api/src/database/migrations ./dist/database/migrations
# Real demo vehicle photos (discovery.ts's seedPhotos, __dirname-relative to the compiled seed
# module) — tsc only emits .ts->.js, so these binary assets need their own copy or every dev-seed
# install silently keeps every vehicle's imageRef unset instead of using a real photo.
COPY --from=build --chown=node:node /app/apps/api/src/database/seed/assets ./dist/database/seed/assets
COPY --from=build --chown=node:node /app/apps/api/package.json ./package.json
# OBJECT_STORAGE_FS_ROOT (default ./var/objects, DEC-015's filesystem driver — driver-license
# photos, data-export downloads, the dev seed's vehicle photos) resolves under WORKDIR at
# runtime. /app itself is root-owned (only the COPYs above are chowned to node), so without this
# the node user gets EACCES the first time anything tries to create it.
RUN mkdir -p var/objects && chown -R node:node var
# Provenance for GET /health/version (both optional in env.schema — empty is fine).
ARG GIT_SHA=""
ARG BUILD_TIME=""
ENV GIT_SHA=$GIT_SHA BUILD_TIME=$BUILD_TIME
USER node
EXPOSE 3001
# --timeout and --start-period both widened (were 5s/25s) after a live false-unhealthy: this
# check spawns a whole new Node process every run, and under real CPU contention that spawn alone
# can exceed 5s even though the already-running server answers real requests instantly — Docker
# then marks the container unhealthy for a problem that was in the healthcheck's own overhead, not
# the app. --start-period is separately generous because OpenTelemetry's auto-instrumentation
# (tracing.ts, opt-in) scans node_modules at boot before the server starts listening; on a
# constrained host under load this was observed taking minutes, not the previous window's seconds.
HEALTHCHECK --interval=20s --timeout=10s --start-period=90s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:3001/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/main.js"]
