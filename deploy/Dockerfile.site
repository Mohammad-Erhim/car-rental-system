# syntax=docker/dockerfile:1.7
# Car Rental System — public site (Next.js App Router, DEC-023).
#   dev target  : next dev with HMR, source bind-mounted by compose.yaml
#   runtime tgt : `next build` standalone output, non-root, healthchecked
#
#   docker build -f deploy/Dockerfile.site --target runtime -t carrental-site .

########################  base  ########################
FROM node:22-bookworm-slim AS base
# max-old-space-size pinned rather than left to Node's default — see deploy/Dockerfile.api's base
# stage for why (V8-OOM mid-build on small/burstable instances otherwise).
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1 NODE_OPTIONS=--max-old-space-size=2048
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate \
 && pnpm config set store-dir /pnpm/store --global
WORKDIR /app

########################  deps  ########################
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY apps/api/package.json           apps/api/package.json
COPY apps/web/package.json           apps/web/package.json
COPY apps/site/package.json          apps/site/package.json
COPY e2e/package.json                e2e/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/client/package.json    packages/client/package.json
COPY packages/i18n/package.json      packages/i18n/package.json
COPY packages/ui/package.json        packages/ui/package.json
COPY packages/theme/package.json     packages/theme/package.json
COPY packages/config/package.json    packages/config/package.json
COPY scripts/patch-expo-localization.mjs scripts/patch-expo-localization.mjs
COPY scripts/patch-stripe-cardfield.mjs   scripts/patch-stripe-cardfield.mjs
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

########################  dev  ########################
FROM deps AS dev
ENV NODE_ENV=development
EXPOSE 3000
CMD ["pnpm", "--filter", "@carrental/site", "dev"]

########################  build  ########################
FROM deps AS build
# `next.config.mjs` bakes `rewrites()` at build time. In the edge-fronted prod stack the edge
# owns `/ops` routing, so the site image builds with the proxy OFF. Override with
# `--build-arg WEB_UPSTREAM=http://web:3000` for a standalone (edge-less) site deploy.
ARG WEB_UPSTREAM=""
# The ops dashboard's page-builder live preview posts draft edits into this app via
# `postMessage` (apps/site's preview-origin.ts allow-lists the sender). In the single-origin dev
# setup the dashboard is same-origin so no config is needed; a split-subdomain prod deploy (three
# real domains, RUNBOOK.md §1a) puts the dashboard on its own origin, and without this the site
# silently drops every preview update — the iframe loads, editing just never appears to do
# anything, with nothing logged to explain why.
ARG NEXT_PUBLIC_PREVIEW_PARENT_ORIGINS=""
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 WEB_UPSTREAM=$WEB_UPSTREAM \
  NEXT_PUBLIC_PREVIEW_PARENT_ORIGINS=$NEXT_PUBLIC_PREVIEW_PARENT_ORIGINS
COPY tsconfig.base.json ./
COPY packages/ packages/
COPY apps/site/ apps/site/
# Reuses the root build:packages script (theme, contracts, i18n, client, ui) rather than
# duplicating its filter list here — a hand-copied list previously omitted @carrental/client,
# which apps/site imports, and drifted silently out of sync when client was added to the real one.
RUN pnpm build:packages \
 && pnpm --filter @carrental/site build

########################  runtime  ########################
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN apt-get update && apt-get install -y --no-install-recommends tini \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# Next standalone output bundles only the files the server needs.
COPY --from=build --chown=node:node /app/apps/site/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/site/.next/static ./apps/site/.next/static
COPY --from=build --chown=node:node /app/apps/site/public ./apps/site/public
USER node
EXPOSE 3000
# --timeout/--start-period widened to match deploy/Dockerfile.api's HEALTHCHECK: this check
# spawns a whole new Node process every run (same as api's), and under real CPU contention on a
# small instance that spawn alone can exceed the old 5s timeout even though the already-running
# server answers real requests fine — observed as a false "unhealthy" while site was actually
# serving 200s.
HEALTHCHECK --interval=15s --timeout=10s --start-period=90s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:3000/en').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/site/server.js"]
