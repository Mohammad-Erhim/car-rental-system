# syntax=docker/dockerfile:1.7
# Car Rental System — Customer Web + Operations Dashboard (one Vite SPA, DEC-004/018).
#   dev target  : vite dev server with HMR, source bind-mounted by compose.yaml
#   runtime tgt : static bundle served by nginx, /api + /health proxied to the API service
#
#   docker build -f deploy/Dockerfile.web --target runtime -t carrental-web .
#   docker build -f deploy/Dockerfile.web --target dev     -t carrental-web:dev .

########################  base  ########################
FROM node:22-bookworm-slim AS base
# max-old-space-size pinned rather than left to Node's default — see deploy/Dockerfile.api's base
# stage for why (V8-OOM mid-build on small/burstable instances otherwise).
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1 NODE_OPTIONS=--max-old-space-size=2048
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate \
 && pnpm config set store-dir /pnpm/store --global
WORKDIR /app

########################  deps  ########################
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY apps/api/package.json           apps/api/package.json
COPY apps/web/package.json           apps/web/package.json
COPY e2e/package.json                e2e/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/client/package.json    packages/client/package.json
COPY packages/i18n/package.json      packages/i18n/package.json
COPY packages/ui/package.json        packages/ui/package.json
COPY packages/theme/package.json     packages/theme/package.json
COPY packages/config/package.json    packages/config/package.json
COPY scripts/patch-expo-localization.mjs scripts/patch-expo-localization.mjs
COPY scripts/patch-stripe-cardfield.mjs   scripts/patch-stripe-cardfield.mjs
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

########################  dev  ########################
# Vite bundles the shared packages from TS source (see vite.config aliases), so no package
# build step is needed. Source is bind-mounted by compose.
FROM deps AS dev
ENV NODE_ENV=development
EXPOSE 3100
CMD ["pnpm", "--filter", "@carrental/web", "dev", "--", "--host", "0.0.0.0"]

########################  build  ########################
FROM deps AS build
ENV NODE_ENV=production
# Vite inlines VITE_* vars at build time, not runtime — unset, apps/web/src/lib/site-origin.ts
# falls back to the browser's current origin for the "live preview" iframe / "view public site"
# link. That's correct for the single-origin deploy (site *is* this origin) but wrong the moment
# site/ops are split across subdomains: the dashboard's own origin has no route for the site's
# pages, so the preview 404s (verified live). Pass the real site origin for a split deploy.
ARG VITE_SITE_URL=""
ENV VITE_SITE_URL=$VITE_SITE_URL
COPY tsconfig.base.json ./
COPY packages/ packages/
COPY apps/web/ apps/web/
# Reuses the root build:packages script (theme, contracts, i18n, client, ui) rather than
# duplicating its filter list here — a hand-copied list previously omitted @carrental/client,
# which apps/web imports, and drifted silently out of sync when client was added to the real one.
RUN pnpm build:packages \
 && pnpm --filter @carrental/web build

########################  runtime  ########################
FROM nginx:1.27-alpine AS runtime
ENV API_UPSTREAM=http://api:3001
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html/ops
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8080/ops/ >/dev/null 2>&1 || exit 1
# nginx:alpine entrypoint renders /etc/nginx/templates/*.template with envsubst, then runs nginx.
