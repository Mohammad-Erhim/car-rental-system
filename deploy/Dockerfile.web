# Car Rental System — Customer Web + Operations Dashboard (one Vite SPA, DEC-004/018).
# Build the static bundle, serve it with nginx, proxy /api and /health to the API service.
#
#   docker build -f deploy/Dockerfile.web -t carrental-web .
#   docker run -p 3000:8080 -e API_UPSTREAM=http://api:3001 carrental-web

# ---- build ----------------------------------------------------------------------
FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc* tsconfig.base.json ./
COPY packages/ packages/
COPY apps/web/ apps/web/
RUN pnpm install --frozen-lockfile --filter @carrental/web... --prod=false \
 && pnpm --filter @carrental/contracts --filter @carrental/i18n --filter @carrental/ui build \
 && pnpm --filter @carrental/web build

# ---- runtime ------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime
ENV API_UPSTREAM=http://api:3001
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=4s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1
# nginx:alpine entrypoint renders /etc/nginx/templates/*.template with envsubst, then runs nginx.
