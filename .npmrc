shared-workspace-lockfile=true
link-workspace-packages=true
prefer-workspace-packages=true
auto-install-peers=true
strict-peer-dependencies=false
# Keep memory/disk modest on constrained hosts
node-linker=isolated
# apps/mobile's generated android/settings.gradle resolves @react-native/gradle-plugin via
# plain `require.resolve` (no `paths` option), which only works if it's hoisted to a
# node_modules directory on the walk-up from android/ - isolated linking nests it under
# react-native's own node_modules instead. Hoist just this scope so local/CI gradle builds work.
public-hoist-pattern[]=@react-native/*
