shared-workspace-lockfile=true
link-workspace-packages=true
prefer-workspace-packages=true
auto-install-peers=true
strict-peer-dependencies=false
# Keep memory/disk modest on constrained hosts
node-linker=isolated
# apps/mobile's generated android/settings.gradle resolves @react-native/gradle-plugin via
# plain `require.resolve` (no `paths` option), which only works if it's hoisted to a
# node_modules directory on the walk-up from android/ - isolated linking nests it under
# react-native's own node_modules instead. Hoist just this scope so local/CI gradle builds work.
public-hoist-pattern[]=@react-native/*
# Same walk-up `require.resolve` problem, but for Expo's own autolinking Gradle scripts: nested
# under isolated linking, they can resolve a stale/wrong copy of expo-modules-autolinking and
# generate a PackageList.java that imports a class path (expo.core.ExpoModulesPackage) that
# doesn't exist in the installed expo-modules-core, failing the Android build with "cannot find
# symbol". Hoisting these makes the walk-up land on the one version actually in use.
public-hoist-pattern[]=*expo-modules-autolinking*
public-hoist-pattern[]=*expo-modules-core*
public-hoist-pattern[]=*babel-preset-expo*
