# ---------------------------------------------------------------------------
# Car Rental System — environment template. Copy to .env and fill locally.
# NEVER commit a real .env. All values here are placeholders.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API ---
API_PORT=3001
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
# Site origin (:3000) is the single origin in dev — apps/site proxies /api and /ops.
# :3100 is the dashboard dev server for direct access (pnpm --filter @carrental/web dev).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# --- Database (native PostgreSQL 16 on this host; see scripts/dev-up.sh) ---
DATABASE_URL=postgresql://carrental:carrental_dev_pw@127.0.0.1:5432/carrental_dev
DATABASE_URL_TEST=postgresql://carrental:carrental_dev_pw@127.0.0.1:5432/carrental_test
# Used only by compose.prod.yaml's own postgres container + the DATABASE_URL it builds from it —
# not read by the app directly. MUST be a real, unique value in production; there is no default.
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD

# --- Cache / queue (Redis 7 stands in for Valkey — DEC-014) ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL_TEST=redis://127.0.0.1:6379/1

# --- Auth (DEC-005). Generate real secrets with: openssl rand -base64 48 ---
JWT_ACCESS_SECRET=REPLACE_ME_ACCESS_SECRET
JWT_ACCESS_TTL=900
JWT_ISSUER=car-rental-system
JWT_AUDIENCE_CUSTOMER=carrental.customer
JWT_AUDIENCE_STAFF=carrental.staff
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_PEPPER=REPLACE_ME_PEPPER
COOKIE_SECRET=REPLACE_ME_COOKIE_SECRET

# --- Object storage (DEC-015): fs | s3 ---
OBJECT_STORAGE_DRIVER=fs
OBJECT_STORAGE_FS_ROOT=./var/objects
OBJECT_STORAGE_SIGNING_SECRET=REPLACE_ME_OBJ_SIGNING
# S3 (only when OBJECT_STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Mail / messaging (DEC-016): outbox | smtp ---
MAIL_DRIVER=outbox
MAIL_FROM="Car Rental <no-reply@example.test>"
SMTP_URL=
SMS_DRIVER=outbox
PUSH_DRIVER=outbox

# --- Payments (DEC-006): simulator | stripe_test | stripe_live is now a dashboard-configurable
# setting (SCREEN-OPS-041, /ops/config/payments — administrator only), not an env var. These are
# kept only as the seed default for a brand-new install with nothing configured yet.
PAYMENT_DRIVER=simulator
PAYMENT_WEBHOOK_SECRET=REPLACE_ME_PAY_WEBHOOK
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# At-rest encryption key for the Stripe keys the dashboard saves to the database — an operator
# secret, same tier as PASSWORD_PEPPER/COOKIE_SECRET below. MUST be a real, unique value in
# production (32+ random bytes; `openssl rand -base64 32`).
PAYMENT_CONFIG_ENCRYPTION_KEY=REPLACE_ME_PAYMENT_CONFIG_ENCRYPTION_KEY

# --- Maps (DEC-019) ---
MAPS_ENABLED=0
MAP_STYLE_URL=

# --- Abuse controls (SRS-SEC-015). Fixed-window limiter per client IP, Redis-backed. ---
# On/off flags read 1/true/yes/on and 0/false/no/off; RATE_LIMIT_ENABLED=0 is the emergency switch.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_AUTH_MAX=40
RATE_LIMIT_AUTH_WINDOW_SEC=60
# The payment step of checkout (POST /bookings/confirm, DEC-040): a guest reaches it with no account
# and every call is a card authorisation. Keep it well above what one office books in a minute.
RATE_LIMIT_BOOKING_CONFIRM_MAX=20
RATE_LIMIT_BOOKING_CONFIRM_WINDOW_SEC=60

# --- Observability (DEC-017, DEC-043). Leave OTEL endpoint empty to disable export — the SDK
# never even initialises, zero added overhead. Point it at a Tempo instance's OTLP/HTTP endpoint
# (compose.admin.yaml's tempo service: http://tempo:4318/v1/traces) to turn tracing on.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
# Fraction of requests traced when the above is set (1 = trace everything).
OTEL_TRACES_SAMPLE_RATIO=0.2
METRICS_ENABLED=1
# Shared secret required on the X-Metrics-Token header to read /metrics. Leave empty for local
# dev; every real deployment should set it and configure the same value in the Prometheus scrape.
METRICS_TOKEN=

# --- Web (Vite) ---
VITE_API_BASE_URL=/api/v1
VITE_MAPS_ENABLED=0

# --- Admin/observability stack (compose.admin.yaml, opt-in — deploy/ADMIN-RUNBOOK.md) ---
# Grafana's own admin login; Portainer's is set separately via a password-hash file (RUNBOOK).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_GRAFANA_ADMIN_PASSWORD
# Ports admin-edge (nginx, HTTP Basic Auth) publishes Portainer/Grafana/Adminer/Prometheus on.
ADMIN_PORTAINER_PORT=8091
ADMIN_GRAFANA_PORT=8092
ADMIN_ADMINER_PORT=8093
ADMIN_PROMETHEUS_PORT=8094
