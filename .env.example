# ---------------------------------------------------------------------------
# Car Rental System — environment template. Copy to .env and fill locally.
# NEVER commit a real .env. All values here are placeholders.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API ---
API_PORT=3001
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
# Site origin (:3000) is the single origin in dev — apps/site proxies /api and /ops.
# :3100 is the dashboard dev server for direct access (pnpm --filter @carrental/web dev).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# --- Database (native PostgreSQL 16 on this host; see scripts/dev-up.sh) ---
DATABASE_URL=postgresql://carrental:carrental_dev_pw@127.0.0.1:5432/carrental_dev
DATABASE_URL_TEST=postgresql://carrental:carrental_dev_pw@127.0.0.1:5432/carrental_test

# --- Cache / queue (Redis 7 stands in for Valkey — DEC-014) ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL_TEST=redis://127.0.0.1:6379/1

# --- Auth (DEC-005). Generate real secrets with: openssl rand -base64 48 ---
JWT_ACCESS_SECRET=REPLACE_ME_ACCESS_SECRET
JWT_ACCESS_TTL=900
JWT_ISSUER=car-rental-system
JWT_AUDIENCE_CUSTOMER=carrental.customer
JWT_AUDIENCE_STAFF=carrental.staff
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_PEPPER=REPLACE_ME_PEPPER
COOKIE_SECRET=REPLACE_ME_COOKIE_SECRET

# --- Object storage (DEC-015): fs | s3 ---
OBJECT_STORAGE_DRIVER=fs
OBJECT_STORAGE_FS_ROOT=./var/objects
OBJECT_STORAGE_SIGNING_SECRET=REPLACE_ME_OBJ_SIGNING
# S3 (only when OBJECT_STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Mail / messaging (DEC-016): outbox | smtp ---
MAIL_DRIVER=outbox
MAIL_FROM="Car Rental <no-reply@example.test>"
SMTP_URL=
SMS_DRIVER=outbox
PUSH_DRIVER=outbox

# --- Payments (DEC-006): simulator | stripe_test | stripe_live is now a dashboard-configurable
# setting (SCREEN-OPS-041, /ops/config/payments — administrator only), not an env var. These are
# kept only as the seed default for a brand-new install with nothing configured yet.
PAYMENT_DRIVER=simulator
PAYMENT_WEBHOOK_SECRET=REPLACE_ME_PAY_WEBHOOK
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# At-rest encryption key for the Stripe keys the dashboard saves to the database — an operator
# secret, same tier as PASSWORD_PEPPER/COOKIE_SECRET below. MUST be a real, unique value in
# production (32+ random bytes; `openssl rand -base64 32`).
PAYMENT_CONFIG_ENCRYPTION_KEY=REPLACE_ME_PAYMENT_CONFIG_ENCRYPTION_KEY

# --- Maps (DEC-019) ---
MAPS_ENABLED=0
MAP_STYLE_URL=

# --- External identity (optional adapter) ---
IDENTITY_DRIVER=simulator

# --- Abuse controls (SRS-SEC-015). Fixed-window limiter on auth routes, Redis-backed. ---
RATE_LIMIT_ENABLED=1
RATE_LIMIT_AUTH_MAX=40
RATE_LIMIT_AUTH_WINDOW_SEC=60

# --- Observability (DEC-017). Leave OTEL endpoint empty to disable export. ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=1

# --- Web (Vite) ---
VITE_API_BASE_URL=/api/v1
VITE_MAPS_ENABLED=0
